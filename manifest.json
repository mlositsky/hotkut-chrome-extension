{
  "manifest_version": 3,
  "name": "Quick Switch To Tab",
  "version": "1.0",
  "icons": {
     "16": "icon16.png",
     "48": "icon48.png",
     "128": "icon128.png"
   },
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Options",
    "default_icon": {
       "16": "icon16.png",
       "48": "icon48.png"
     }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "commands": {
    "focus-site-1": {
      "description": "Qwen"
    },
    "focus-site-2": {
      "description": "Chat GPT"
    },
    "focus-site-3": {
      "description": "Perplexity"
    },
    "focus-site-4": {
      "description": "Custom site 1 "
    },
    "focus-site-5": {
      "description": "Custom site 2"
    }
  }
}