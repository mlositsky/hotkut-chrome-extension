{
  "manifest_version": 3,
  "name": "HotKut",
  "version": "1.0",
  "icons": {
     "48": "icon48.png"
   },
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Options",
    "default_icon": {
      "48": "icon48.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "commands": {
    "focus-site-1": {
      "description": "Qwen",
      "suggested_key": {
        "default": "Alt+Shift+1"
      }
    },
    "focus-site-2": {
      "description": "Chat GPT",
      "suggested_key": {
        "default": "Alt+Shift+2"
      }
    },
    "focus-site-3": {
      "description": "Perplexity",
      "suggested_key": {
        "default": "Alt+Shift+3"
      }
    },
    "focus-site-4": {
      "description": "Claude",
      "suggested_key": {
        "default": "Alt+Shift+4"
      }
    },
    "focus-site-5": {
      "description": "Custom site 1"
    }
  }
}